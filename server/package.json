{
    "name": "solken-mcp-revit",
    "version": "1.0.0",
    "description": "MCP server for Autodesk Revit, part of the Solken BIM toolchain -- read model data and quantities from Revit through any MCP-compatible AI client. Free component of Solken Agent.",
    "main": "index.js",
    "type": "module",
    "bin": {
        "solken-mcp-revit": "./build/index.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "clean": "rimraf build",
        "prebuild": "npm run clean",
        "build": "tsc",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Solken-bim-mx/solken-mcp-revit.git"
    },
    "keywords": [
        "mcp",
        "revit",
        "autodesk",
        "claude",
        "ai",
        "bim",
        "architecture",
        "solken"
    ],
    "license": "MIT",
    "author": "Carlos I. Rodríguez Herrera (Solken)",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/Solken-bim-mx/solken-mcp-revit/issues"
    },
    "homepage": "https://solkenbim.com",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.7.0",
        "better-sqlite3": "^12.8.0",
        "ws": "^8.18.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.13.10",
        "@types/ws": "^8.18.0",
        "rimraf": "^5.0.10",
        "typescript": "^5.8.2"
    }
}
